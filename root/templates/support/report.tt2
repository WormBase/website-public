[%- # This is the generic report page for Support WormBase -%]

[%
      breadcrumbs = [];

      breadcrumbs.push(path_parts ? '<a href="' _ c.uri_for('/support') _ '">Support</a>' : 'Support');
      IF path_parts;
         FOREACH path IN path_parts;
            title = path.replace('_', ' ') FILTER ucfirst;
            breadcrumbs.push(loop.last ? '<span>' _ title _ '</span>' : '<a href="' _ c.uri_for('/support', path_parts.slice(0, loop.count - 1).join('/')) _ '">' _ title _ '</a>');
         END;
      END;

      report_page(breadcrumbs);
%]

[% IF c.config.installation_type == 'development' %]
    <script type="text/javascript" src="[% accept_js.sandbox %]"></script>
[% ELSE %]
    <script type="text/javascript" src="[% accept_js.production %]"></script>
[% END %]

<style>
/* Payment form styles - scoped to avoid affecting other elements */
#paymentForm .payment-form {
    background: #fff;
    padding: 1.5em;
    border: 1px solid #C2D1DF;
    border-radius: 4px;
    max-width: 300px;
    margin: 1em 0;
}

#paymentForm .form-group {
    margin-bottom: 1.2em;
    position: relative;
}

#paymentForm label {
    display: block;
    color: #224162;
    font-weight: bold;
    margin-bottom: 0.5em;
    font-size: 0.9em;
}

#paymentForm input[type="text"] {
    width: 200px;
    padding: 0.6em;
    border: 1px solid #C2D1DF;
    border-radius: 4px;
    font-size: 1em;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
}

#paymentForm input[type="text"]:focus {
    border-color: #406F9C;
    outline: none;
    box-shadow: 0 0 5px rgba(64, 111, 156, 0.2);
}

#paymentForm button[type="submit"] {
    background: #406F9C;
    background: linear-gradient(to bottom, #8CA4BA, #406F9C);
    color: white;
    padding: 0.8em 1.5em;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    width: 200px;
    font-size: 1em;
    transition: background 0.2s ease;
}

#paymentForm button[type="submit"]:hover {
    background: #8CA4BA;
    background: linear-gradient(to bottom, #A3BCD4, #406F9C);
}

#paymentForm input#cardCode {
    width: 80px;
}

#paymentForm .expiration-group {
    display: flex;
    gap: 1em;
}

#paymentForm .expiration-group .form-group {
    flex: 1;
}

#paymentForm .expiration-group input[type="text"] {
    width: 80px;
}

#paymentForm input.error {
    border-color: #9C4041;
    background-color: #FED;
}

#paymentForm .error-message {
    color: #9C4041;
    font-size: 0.8em;
    margin-top: 0.3em;
    display: none;
}

#paymentForm button[type="submit"].loading {
    background: #C2D1DF;
    cursor: wait;
    position: relative;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>


<script type="text/javascript">
function sendPaymentDataToAnet() {
    var secureData = {}, authData = {}, cardData = {};
    
    cardData.cardNumber = document.getElementById('cardNumber').value;
    cardData.month = document.getElementById('expirationMonth').value;
    cardData.year = document.getElementById('expirationYear').value;
    cardData.cardCode = document.getElementById('cardCode').value;
    
    secureData.cardData = cardData;

    // The Authorize.Net Client Key should be provided by your server
    authData.clientKey = "[% c.config.authorize_net.client_key %]";
    authData.apiLoginID = "[% c.config.authorize_net.api_login_id %]";
    
    secureData.authData = authData;

    Accept.dispatchData(secureData, responseHandler);

    return false;
}

function responseHandler(response) {
    if (response.messages.resultCode === "Error") {
        var i = 0;
        while (i < response.messages.message.length) {
            console.log(response.messages.message[i].code + ": " + 
                response.messages.message[i].text);
            i = i + 1;
        }
    } else {
        document.getElementById("dataDescriptor").value = response.opaqueData.dataDescriptor;
        document.getElementById("dataValue").value = response.opaqueData.dataValue;
        document.getElementById("paymentForm").submit();
    }
}
</script>
